{
  "name": "ansh-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run sync:pdfjs",
    "build": "next build",
    "prebuild": "npm run sync:pdfjs",
    "start": "next start",
    "sync:pdfjs": "node scripts/sync-pdfjs.mjs",
    "postinstall": "npm run sync:pdfjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint -- --max-warnings=0 && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tabler/icons-react": "^3.49.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "motion": "^12.18.1",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
